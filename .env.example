# Copy this file to .env and change every value before running in production.

# Random long random string — used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-64-char-hex-string

# SQLite by default, which is right for running on one machine.
#
# Hosted deployments use Postgres instead — paste the provider's connection
# string verbatim, including "?sslmode=require"; the app adds the driver
# part itself. Neon looks like:
#   DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/jsw_cf?sslmode=require
DATABASE_URL=sqlite:///./data/jsw_cf.db

# First-run admin account. Only used the very first time the app starts
# (when the users table is empty). Change the password immediately after
# first login via the Users page.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Set to "production" to disable the auto-reload / debug behaviours.
ENV=development
